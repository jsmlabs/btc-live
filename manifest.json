{
  "manifest_version": 3,
  "name": "BTC Live",
  "short_name": "BTC Live",
  "description": "Private, lightweight Bitcoin live price monitor powered by Binance Spot market data.",
  "version": "1.13.0",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "BTC Live",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "permissions": [
    "storage",
    "notifications",
    "alarms"
  ],
  "host_permissions": [
    "https://api.binance.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src https://api.binance.com wss://stream.binance.com:443"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  }
}
